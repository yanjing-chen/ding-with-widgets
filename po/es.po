msgid ""
"\n"
"<b>Set Permissions, in \"Others Access\", \"Read Only\" or \"None\"</b>"
msgstr ""
"\n"
"<b>Cambiar los permisos, en \"Otros accesos\", a \"Sólo lectura\" o "
"\"Ninguno\"</b>"

