{
  "id": "ding.mac.calendar",
  "name": "日历",
  "description": "可翻页的中国农历、传统节日和法定节假日日历",
  "kind": "html",
  "entry": "index.html",
  "version": 12,
  "defaultWidth": 400,
  "defaultHeight": 380,
  "minimumWidth": 200,
  "minimumHeight": 210,
  "defaultConfig": {
    "layoutPreset": "medium",
    "showLunar": true,
    "showFestivals": true,
    "showStatutory": true,
    "showWorkdays": true,
    "weekStartsMonday": true,
    "opacity": 1,
    "holidayCache": null,
    "holidayLastUpdate": ""
  }
}
